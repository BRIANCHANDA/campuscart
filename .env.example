# ============================================================================
# CampusCart — environment configuration
# Copy to `.env` and fill the blanks. Payments and delivery both fall back to
# safe mocks when their keys are empty, so the app runs end-to-end locally with
# nothing but DATABASE_URL + JWT_SECRET set.
# ============================================================================

# --- API ---
PORT=3000
DATABASE_URL=postgres://campuscart:campuscart@localhost:5432/campuscart
# Must be at least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_EXPIRES_IN_SECONDS=86400
# How long replayable Idempotency-Key records are kept before the hourly
# sweeper drops them. Only needs to outlive a client's retry horizon.
IDEMPOTENCY_RETENTION_HOURS=48

# --- Yango Delivery (server-side only, never shipped to clients) ---
# Leave the key blank to use the mock delivery provider in dev.
YANGO_API_BASE_URL=https://b2b.taxi.yango.com
YANGO_API_KEY=
YANGO_CLIENT_ID=
YANGO_WEBHOOK_SECRET=

# ============================================================================
# PAYMENTS — Mobile money (Zambia). Customers choose Airtel or MTN at checkout.
# Each wallet goes LIVE as soon as its keys below are filled; until then that
# method transparently uses a mock that auto-approves (great for demos).
# PAYMENT_PROVIDER is only a legacy default and can stay "mock".
# ============================================================================
PAYMENT_PROVIDER=mock            # mock | stripe | mtn_momo | airtel_money

# --- Lenco (RECOMMENDED) -------------------------------------------------
# One aggregator covering MTN, Airtel and Zamtel, for both collections and
# courier payouts. Setting LENCO_API_KEY takes precedence over the direct MTN
# and Airtel integrations below — running both would mean two paths to the same
# wallet and two webhooks settling the same payment.
LENCO_API_BASE_URL=https://api.lenco.co/access/v2
LENCO_API_KEY=
# 36-char account UUID that payouts debit. Required for courier settlement.
LENCO_ACCOUNT_ID=
# Who absorbs the collection fee: merchant (you) or customer.
LENCO_FEE_BEARER=merchant
# Webhook: point Lenco at POST /webhooks/payments/lenco. There is no separate
# secret — signatures are HMAC-SHA512 keyed on a SHA-256 of LENCO_API_KEY.

# --- MTN Mobile Money (Collections API) — legacy, superseded by Lenco ----
# Portal: https://momodeveloper.mtn.com  -> subscribe to "Collections".
# Sandbox base: https://sandbox.momodeveloper.mtn.com  (target env: sandbox)
# Zambia prod base: https://proxy.momoapi.mtn.com      (target env: mtnzambia)
# Register the callback URL below in the portal, pointing at:
#   https://<your-api-host>/webhooks/payments/mtn
MOMO_API_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CALLBACK_URL=
# Optional: enables MoMo refunds via the Disbursements product
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=

# --- Airtel Money (Merchant payments) -----------------------------------
# Portal: https://developers.airtel.africa  -> "Collection / Merchant payments".
# UAT base:  https://openapiuat.airtel.africa
# Prod base: https://openapi.airtel.africa
# Register the callback URL in the portal, pointing at:
#   https://<your-api-host>/webhooks/payments/airtel
AIRTEL_API_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_COUNTRY=ZM
# Optional: HMAC-SHA256 secret Airtel signs callbacks with (verified when set)
AIRTEL_CALLBACK_SECRET=

# --- Stripe (optional, cards) -------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Infra (optional) ---
REDIS_URL=

# --- Mobile / Admin clients ---
# The mobile app derives the API URL from its own host on web; for a physical
# device set this to your machine's LAN IP (or the deployed API host).
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
# Web admin console -> API base:
# VITE_API_URL=http://localhost:3000
