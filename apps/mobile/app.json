{
  "expo": {
    "name": "CampusCart",
    "slug": "campuscart",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-asset",
      "expo-secure-store"
    ],
    "android": {
      "package": "com.campuscart.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.campuscart.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "CampusCart uses your location to show couriers nearby and estimate delivery."
      }
    },
    "extra": {
      "eas": {
        "projectId": "33d5f62f-6abc-4947-ac75-38207006c4b6"
      }
    },
    "owner": "brian.chanda"
  }
}
